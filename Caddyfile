# Apex + www in one block — avoids ambiguity with other site definitions.
# www requests are redirected to the apex; all others are proxied to the portal.
jianglabs.com, www.jianglabs.com {
    # Redirect www to apex
    @www host www.jianglabs.com
    redir @www https://jianglabs.com{uri} permanent

    # Reverse proxy to the Docker container.
    # Replace 'portal:3000' with the actual hostname/port if Caddy runs on the host.
    reverse_proxy portal:3000

    # Security headers
    header {
        # Remove server fingerprinting
        -Server
        -X-Powered-By

        # Security
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "camera=(), microphone=(), geolocation=()"

        # CSP — tighten as needed; 'unsafe-inline' required for Next.js inline styles
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"
    }

    # Logging
    log {
        output stdout
    }
}
