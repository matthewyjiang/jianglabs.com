# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# The full public URL of this portal (no trailing slash)
AUTH_URL=https://jianglabs.com

# ─── Authentik OIDC ───────────────────────────────────────────────────────────
# The base URL of your Authentik instance (no trailing slash)
AUTHENTIK_URL=https://auth.jianglabs.com

# The OIDC issuer — must match the application slug in Authentik.
# Format: https://<authentik-host>/application/o/<application-slug>
# Do NOT include a trailing slash.
# Example slug: jianglabs-portal
AUTHENTIK_ISSUER=https://auth.jianglabs.com/application/o/jianglabs-portal

# OAuth2 client credentials from the Authentik provider settings
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# The application slug used to build deep-links (e.g., the end-session URL).
# Should match the slug used in AUTHENTIK_ISSUER.
AUTHENTIK_APPLICATION_SLUG=jianglabs-portal

# ─── Access resolution ────────────────────────────────────────────────────────
# Controls how the portal decides which apps to show each user.
#
# authentik-api  — query /api/v3/core/applications/ with the user's token.
#                  Most accurate. Requires the 'goauthentik.io/api' scope
#                  mapping on the provider. Shows an error if unavailable.
# groups         — filter config/apps.ts by the OIDC 'groups' claim only.
#                  No Authentik API call.
# hybrid         — (default) try API; fall back to groups on failure.
#                  Never shows a blank dashboard on misconfiguration.
ACCESS_MODE=hybrid
